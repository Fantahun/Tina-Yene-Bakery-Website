// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // The build runs on Windows but the app runs on Hostinger's Linux host, so the
  // Windows-only engine generated by default would not load there. Emit the
  // Debian engine alongside the native one so the deployment package can ship it.
  // If the server reports a different distro, add its target here and rebuild
  // (e.g. "debian-openssl-1.1.x" for older images, "rhel-openssl-3.0.x" on RHEL).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATA_BASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATA_BASE_URL")
}

enum FulfillmentMethod {
  pickup
  delivery
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               Int         @id @default(autoincrement())
  categoryId       Int
  name             String
  slug             String      @unique
  description      String?
  price            Decimal     @db.Decimal(10, 2)
  hasSizes         Boolean     @default(false)
  imageUrl         String?
  prepLeadTimeDays Int         @default(0)
  pickupAllowed    Boolean     @default(true)
  deliveryAllowed  Boolean     @default(true)
  isActive         Boolean     @default(true)
  sortOrder        Int         @default(0)
  deletedAt        DateTime?
  createdBy        String?
  createdAt        DateTime    @default(now())
  updatedBy        String?
  updatedAt        DateTime    @updatedAt
  category         Category    @relation(fields: [categoryId], references: [id])
  sizes            ProductSize[]
  orderItems       OrderItem[]

  @@index([categoryId])
}

model ProductSize {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  serves    String?
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model PickupLocation {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  orders    Order[]
}

model SiteSetting {
  id               Int      @id @default(autoincrement())
  cutoffTime       String?
  deliveryFee      Decimal  @db.Decimal(10, 2)
  minOrderDelivery Decimal  @db.Decimal(10, 2)
  storePhone       String
  storeEmail       String
  dashboardPendingStatusId     Int?
  dashboardInProgressStatusId  Int?
  dashboardReadyStatusId       Int?
  dashboardPendingStatus       OrderStatusEntry? @relation("DashboardPendingStatus", fields: [dashboardPendingStatusId], references: [id])
  dashboardInProgressStatus    OrderStatusEntry? @relation("DashboardInProgressStatus", fields: [dashboardInProgressStatusId], references: [id])
  dashboardReadyStatus         OrderStatusEntry? @relation("DashboardReadyStatus", fields: [dashboardReadyStatusId], references: [id])
  contactReceiverEmails        String?
  contactSenderEmail           String?
  maxContactSubmissionsPerDay  Int      @default(5)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedBy        String?
  updatedAt        DateTime @updatedAt
}

model OrderStatusEntry {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  dashboardPendingFor    SiteSetting[] @relation("DashboardPendingStatus")
  dashboardInProgressFor SiteSetting[] @relation("DashboardInProgressStatus")
  dashboardReadyFor      SiteSetting[] @relation("DashboardReadyStatus")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                 String            @id @default(uuid())
  confirmationNumber String            @unique
  customerName       String
  customerEmail      String
  customerPhone      String
  businessName       String?
  fulfillmentMethod  FulfillmentMethod
  fulfillmentDate    DateTime
  pickupLocationId   Int?
  deliveryAddress    String?
  subtotal           Decimal           @db.Decimal(10, 2)
  deliveryFee        Decimal           @db.Decimal(10, 2)
  total              Decimal           @db.Decimal(10, 2)
  orderNotes         String?
  orderStatusId      Int
  paymentStatus      PaymentStatus     @default(pending)
  stripeSessionId    String?           @unique
  stripePaymentIntentId String?        @unique
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedBy          String?
  updatedAt          DateTime          @updatedAt
  pickupLocation     PickupLocation?   @relation(fields: [pickupLocationId], references: [id])
  orderStatus        OrderStatusEntry  @relation(fields: [orderStatusId], references: [id])
  items              OrderItem[]

  @@index([pickupLocationId])
  @@index([orderStatusId])
  @@index([paymentStatus])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   Int?
  productSizeId Int?
  productName String
  sizeName    String?
  serves      String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  productSize ProductSize? @relation(fields: [productSizeId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productSizeId])
}

model AdminUser {
  id                  String              @id @default(uuid())
  username            String              @unique
  fullName            String?
  passwordHash        String
  role                String              @default("admin")
  isActive            Boolean             @default(true)
  phoneNumber         String?
  email               String?
  failedLoginAttempts Int                 @default(0)
  lastFailedLoginAt   DateTime?
  lastLoginAt         DateTime?
  createdBy           String?
  createdAt           DateTime            @default(now())
  updatedBy           String?
  updatedAt           DateTime            @updatedAt
  logins              AdminLoginHistory[]
}

model AdminLoginHistory {
  id          String    @id @default(uuid())
  adminUserId String
  status      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
