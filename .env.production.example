# Build-time production values. Copy to `.env.production` and fill in.
#
# WHY THIS FILE EXISTS
# --------------------
# Next.js inlines every NEXT_PUBLIC_* variable into the compiled output at BUILD
# time - in server chunks as well as client ones. They are literal strings by the
# time the server starts, so setting them in Hostinger's environment panel has no
# effect: the panel cannot change a value that is already compiled in.
#
# Without this file the build picked values from `.env`, which points at
# localhost for local development. That shipped `http://localhost:3001` into
# production and sent paying customers to their own machine after checkout.
#
# `next build` loads `.env.production` ahead of `.env`, so these win at build time
# while `.env` keeps serving `pnpm dev`. Nothing here is secret-by-necessity:
# NEXT_PUBLIC_* values are visible in the browser bundle anyway. Real secrets
# (DATA_BASE_URL, STRIPE_SECRET_KEY, NEXTAUTH_SECRET, EMAIL_*) are read at
# runtime and belong in the hosting environment panel, not here.

# The site's public origin. The build fails if this is missing or local.
NEXT_PUBLIC_BASE_URL=https://yenebakery.com

# Stripe publishable key. Use pk_live_... for real payments - pk_test_... makes
# checkout silently run in test mode with no error shown.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Site modes
NEXT_PUBLIC_COMING_SOON=false
NEXT_PUBLIC_COMING_SOON_TARGET_DATE=2026-04-01T10:00:00Z
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Upper bound on cached storefront queries, in seconds. Admin edits purge the
# caches immediately regardless of this value.
NEXT_PUBLIC_ISR_REVALIDATE_SECONDS=86400
