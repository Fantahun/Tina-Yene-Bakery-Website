#NEXT_PUBLIC_*   related env variables are mainly added during build time and are not used if build zip is uploaded but if the repo is from github or sourcecode upload and build done on hostinger - they are going to be used during build

# Copy to .env and fill in real values. Never commit the filled copy.
#
# On Hostinger, set these in the environment-variable panel instead of shipping a
# .env file - EXCEPT the two build-time values noted below.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Prisma reads DATA_BASE_URL only. The separate DATA_BASE_HOST/PORT/USER/PASSWORD/
# NAME variables that used to live here were referenced nowhere in the codebase
# and have been removed - the connection string is the single source of truth.
#
# On the server this must point at Hostinger's LOCAL MySQL (127.0.0.1), not a
# remote host: a remote database holds each connection open for a full network
# round trip, which inflates the process/thread count on shared hosting.
#
# connection_limit=5 is deliberate - one pooled client against a local database
# is plenty. pool_timeout makes exhaustion fail fast instead of hanging requests.
DATA_BASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name?connection_limit=5&pool_timeout=10&connect_timeout=10

# Only used by `prisma migrate dev` during local development. Production uses
# `prisma migrate deploy`, which never touches it, so it is not needed on the
# server. Must be an empty database.
SHADOW_DATA_BASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_shadow

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Must be the real domain in production. Leaving these as localhost breaks
# NextAuth callbacks and makes server-side fetches hang.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# BUILD-TIME VALUE. This is inlined into the client JavaScript bundle when
# `next build` runs, so setting it in Hostinger's panel has NO effect on a
# locally-built ZIP. Put the live key here BEFORE building for production, or
# checkout silently runs in test mode. See HOSTINGER_DEPLOYMENT.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Port 465 is implicit TLS. The code derives `secure` from the port, so
# SMTP_SECURE is optional and only needed to override a non-standard setup.
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=you@example.com
EMAIL_TO_NOTIFY=orders@example.com

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate (server-to-server cache purges).
REVALIDATE_SECRET=replace_with_long_random_secret

# Upper bound on how long cached storefront queries stay fresh, in seconds.
# Every admin change purges the caches immediately, so this only matters for
# writes that bypass the admin API (e.g. direct SQL). Changeable at runtime.
NEXT_PUBLIC_ISR_REVALIDATE_SECONDS=86400

# ---------------------------------------------------------------------------
# Site modes
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COMING_SOON=false
# BUILD-TIME VALUE (rendered into the client bundle).
NEXT_PUBLIC_COMING_SOON_TARGET_DATE=2026-04-01T10:00:00Z
NEXT_PUBLIC_MAINTENANCE_MODE=false

# NODE_ENV is deliberately not set here: `next dev` sets development and
# `next build` / server.js set production on their own. Forcing it breaks dev mode.
